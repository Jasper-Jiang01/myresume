{
  "name": "portfronted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run clean:src && npm run check:static-leaks",
    "clean:src": "test -d dist && find dist -type d -name \".src\" -prune -exec rm -rf {} + || true",
    "check:static-leaks": "node scripts/check-static-leaks.js",
    "protect:cssdoodle": "node scripts/protect-cssdoodle.js",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "gsap": "^3.15.0",
    "motion": "^13.0.0",
    "next": "14.2.35",
    "openai": "^7.5.0",
    "p5i": "^0.6.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "clean-css-cli": "^5.6.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8",
    "sass": "^1.101.0",
    "tailwindcss": "^3.4.1",
    "terser": "^5.49.1",
    "typescript": "^5"
  }
}
